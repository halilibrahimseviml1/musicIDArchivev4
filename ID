SendReqBtn.MouseButton1Click:Connect(function()
    if tick() - lastRequestTick < 5 then
        SendReqBtn.Text = "Please Wait 5s!"
        task.wait(1.5)
        SendReqBtn.Text = "Send Request"
        return
    end
    
    local sName = NameInput.Text
    local sId = IDInput.Text
    
    if sId == "" or not tonumber(sId) then return end
    if sName == "" then sName = "Audio " .. sId end
    
    lastRequestTick = tick()
    SendReqBtn.Text = "Sending..."
    
    task.spawn(function()
        local payload = HttpService:JSONEncode({
            content = "🎵 **Yeni Müzik İsteği Geldi!**\n👤 **İsteyen:** " .. LocalPlayer.Name .. " (ID: " .. LocalPlayer.UserId .. ")\n🏷️ **Müzik Adı:** " .. sName .. "\n🆔 **Audio ID:** " .. sId
        })
        
        local success = pcall(function()
            sendHttpRequest({
                Url = WEBHOOK_URL,
                Method = "POST",
                Headers = {["Content-Type"] = "application/json"},
                Body = payload
            })
        end)
        
        if success then
            SendReqBtn.Text = "Request Sent! ✔️"
        else
            SendReqBtn.Text = "Error Sending!"
        end
        task.wait(1.5)
        SendReqBtn.Text = "Send Request"
    end)
    IDInput.Text = ""
    NameInput.Text = ""
end)    
end

-- Key Verification Handling
SubmitBtn.MouseButton1Click:Connect(function()
    local userKey = TextBox.Text
    
    local success, result = pcall(function()
        return game:HttpGet(KeyListURL)
    end)
    
    if success then
        local isValid = false
        for key in string.gmatch(result, "[^\r\n]+") do
            if string.match(key, "^%s*(.-)%s*$") == userKey then
                isValid = true
                break
            end
        end
        
        if isValid then
            SubmitBtn.Text = "Success!"
            SubmitBtn.BackgroundColor3 = Color3.fromRGB(0, 255, 128)
            task.wait(1)
            StartMainScript()
        else
            SubmitBtn.Text = "Invalid Key!"
            SubmitBtn.BackgroundColor3 = Color3.fromRGB(255, 50, 50)
            task.wait(1.5)
            SubmitBtn.Text = "Submit Key"
            SubmitBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 255)
        end
    else
        SubmitBtn.Text = "Connection Error!"
        task.wait(1.5)
        SubmitBtn.Text = "Submit Key"
    end
end)
