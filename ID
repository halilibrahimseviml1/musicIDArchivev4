-- Evrensel ve Güvenli Request Fonksiyonu
local function sendHttpRequest(options)
    local req = (syn and syn.request) or (http and http.request) or http_request or request or (fluxus and fluxus.request)
    if req then
        return req(options)
    end
    return nil
end

